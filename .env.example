# Local / IntelliJ. Docker overrides via env/report.env on the server.
# Infra MySQL host port is 3307.

DB_URL=jdbc:mysql://127.0.0.1:3307/report_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=report_user
DB_PASSWORD=report_pass
JPA_DDL_AUTO=update
EUREKA_CLIENT_ENABLED=false
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
OUTBOX_RELAY_ENABLED=false